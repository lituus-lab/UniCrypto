# build artifacts
build/
# bin/ holds the compiled CLI (unicrypto_cli) plus its Nim source. Ignore the
# binary output, track the source. git cannot re-include a file under an
# ignored directory, so ignore `/bin/*` (not `/bin/`) then negate *.nim.
/bin/*
!/bin/*.nim
libUniCrypto.so
libUniCrypto.so.*
libUniCrypto.dylib
libUniCrypto.a
*.o
*.obj
*.exe
*.dll
*.so
*.so.*
*.dylib
*.a
*.lib

# coverage
coverage/
lcov.info

# nim cache
nimcache/
rnimcache/
dnimcache/

# docs output
pages/
docs/
*.html
nimdoc.out.css

# python binding artifacts (sources tracked; generated + bundled lib not)
py/unicrypto/_core.c
py/unicrypto/*.so
py/unicrypto/libUniCrypto.so
py/dist/
py/build/
py/*.egg-info/
py/**/__pycache__/
py/.pytest_cache/

# c test/example binaries
tests/c/test_unicrypto
examples/c/demo

# os / editor
.DS_Store
*~
.*.swp
*.dSYM

*.log
*.core
